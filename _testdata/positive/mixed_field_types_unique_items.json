{
  "openapi": "3.0.3",
  "info": {"title": "Test Mixed Field Types UniqueItems", "version": "0.1.0"},
  "paths": {
    "/records": {
      "get": {
        "operationId": "getRecords",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Record"},
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Record": {
        "type": "object",
        "required": ["id", "name", "active"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "active": {"type": "boolean"},
          "description": {"type": "string"},
          "score": {"type": "number", "nullable": true},
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "owner": {"$ref": "#/components/schemas/Owner"}
        }
      },
      "Owner": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "displayName": {"type": "string"}
        }
      }
    }
  }
}
